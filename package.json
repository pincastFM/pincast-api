{
  "name": "@pincast/api",
  "version": "0.1.0",
  "description": "Typed client for the Pincast card registry (Placecard v1): sets, cards, collects, claims and test apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pincastFM/pincast-api.git"
  },
  "homepage": "https://github.com/pincastFM/pincast-api#readme",
  "bugs": {
    "url": "https://github.com/pincastFM/pincast-api/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./resend-queue": {
      "types": "./src/resend-queue.d.ts",
      "default": "./src/resend-queue.js"
    },
    "./mock": {
      "types": "./src/mock.d.ts",
      "default": "./src/mock.js"
    },
    "./openapi.json": "./openapi/placecard-v1.openapi.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "openapi"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/check-operations.mjs",
    "test": "node --test test/*.test.js",
    "prepack": "node scripts/check-operations.mjs",
    "sync": "node scripts/sync-openapi.mjs",
    "changelog": "node scripts/changelog.mjs"
  },
  "keywords": [
    "pincast",
    "placecard",
    "cards",
    "api",
    "client"
  ]
}
